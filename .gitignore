.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json
.claude/settings.local.json

# The frame budget's numbers, written by the smoke test and CI (tools/frameBudget.mjs).
budget-*.json
.perf

# The radio: songs you add yourself (tools/build_radio_music.py --extras-only)
public/audio/radio-extra/*/*
